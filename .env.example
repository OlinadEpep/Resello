TELEGRAM_TOKEN=tuo_token_qui
TYPESAFE_API_KEY=tua_chiave_typesafe_qui
TYPESAFE_MODEL=jev-latest
# Idea 3: TTL mercato in ore (default 6)
MARKET_TTL_HOURS=6
# Idea 1: rerank pre-fetch (1=attivo, top_k default 8, min score 0.25)
RERANK_ENABLED=1
RERANK_TOP_K=8
RERANK_MIN_SCORE=0.25
# /notifica: ogni quanti secondi ricontrollare i nuovi annunci (default 120, minimo 60)
# ALERT_INTERVAL_SECONDS=120
# /notifica: massimo di messaggi per ricerca a ogni controllo, poi un riepilogo (default 8)
# ALERT_MAX_NOTIFY=8
# Idea 2A: override soglie Jev (JSON, opzionale — vedi scripts/tune_thresholds.py)
# JEV_THRESHOLDS_JSON={"SKIP_NOUL": 0.7, "SKIP_RISK": 0.6}
# Fase 2 mercato: confidence minima product_match e noul massimo per full product
# JEV_THRESHOLDS_JSON={"MARKET_PM_CONF": 0.6, "MARKET_MAX_NOUL": 0.7}
